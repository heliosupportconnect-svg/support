DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/helios_parent_support"
AUTH_SECRET="replace-with-a-long-random-secret"

# Required server-side S3-compatible object storage configuration.
OBJECT_STORAGE_ENDPOINT="https://your-object-storage-endpoint"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ACCESS_KEY_ID="replace-with-server-only-access-key"
OBJECT_STORAGE_SECRET_ACCESS_KEY="replace-with-server-only-secret"
OBJECT_STORAGE_PUBLIC_BASE_URL="https://your-public-object-storage-base-url"

# Create a real AUTH_SECRET in your local .env file. Never commit production credentials.
